# docker compose -f server/docker-compose.yml up -d
# cargo run --manifest-path server/Cargo.toml
# Frontend default API base: http://127.0.0.1:8080

DATABASE_URL=mysql://virtuallab:virtuallab@127.0.0.1:3306/virtuallab
JWT_SECRET=replace-with-a-random-string-of-at-least-32-bytes
DEEPSEEK_API_KEY=replace-with-a-server-side-deepseek-key
BIND=0.0.0.0:8080
ACCESS_TTL_SECS=900
REFRESH_TTL_SECS=1209600
# Optional comma-separated extras. Built-in origins already cover Vite and Tauri.
# CORS_ORIGINS=http://localhost:5173

# One-time reset only (never run during normal startup):
# cargo run --manifest-path server/Cargo.toml --bin reset-data -- --confirm-reset
# RESET_ADMIN_EMAIL=your-email@example.com
# RESET_ADMIN_NAME=Your name
# RESET_ADMIN_PASSWORD=set-via-private-environment
